{
  "Application": {
    "Name": "LearnCSharp Configuration Demo",
    "Version": "1.0.0",
    "EnvironmentLabel": "Base"
  },
  "UserSettings": {
    "DefaultPageSize": 2,
    "AllowUserCreation": true,
    "DefaultEmailDomain": "example.com"
  },
  "ExternalServices": {
    "UserProfileServiceUrl": "https://api.example.com/users",
    "TimeoutSeconds": 10,
    "RetryCount": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ConfigurationDemo": "Debug"
    }
  }
}
